# Names only — set the values in Vercel → Settings → Environment Variables (see README).
# For local development copy this file to .env.local and fill it in; .env files are never committed.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
# Preview sites only (demo mode, separate demo database):
SEED_DEMO=
DEMO_PASSWORD=

# Daily scheduled reports (Vercel Cron sends it as "Authorization: Bearer …"). Any long random text.
CRON_SECRET=
