# Names only — set the values in Vercel → Settings → Environment Variables (see README).
# For local development copy this file to .env.local and fill it in; .env files are never committed.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
# «Demo» inside the app (Administración general → Demo): its OWN database, different from the two above.
TURSO_DEMO_DATABASE_URL=
TURSO_DEMO_AUTH_TOKEN=
# Preview sites only (demo mode, separate demo database):
SEED_DEMO=
DEMO_PASSWORD=

# Daily scheduled reports (Vercel Cron sends it as "Authorization: Bearer …"). Any long random text.
CRON_SECRET=

# Key SIGTUR gives us for automatic sending (Integraciones → Envío automático a SIGTUR). Names only here.
SIGTUR_PUSH_KEY=
